{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "2" }],
      "destination": "/proizvodi",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "10" }],
      "destination": "/proizvodi/drvodekor",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "11" }],
      "destination": "/proizvodi/acrylcolor",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "12" }],
      "destination": "/proizvodi/aluminijum",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "13" }],
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [{ "type": "query", "key": "pid", "value": "14" }],
      "destination": "/proizvodi/ulazna-vrata",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets|favicon|placeholder|robots|sitemap|og-default).*)", "destination": "/index.html" }
  ]
}
